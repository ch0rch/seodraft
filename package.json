{
  "name": "seodraft",
  "version": "0.2.0",
  "description": "Local-first SEO/AEO content engine: installs an agent skill + deterministic scripts into your AI coding harness.",
  "keywords": [
    "seo",
    "aeo",
    "content",
    "markdown",
    "mdx",
    "agent-skill",
    "claude-code",
    "cli",
    "pi-package"
  ],
  "homepage": "https://github.com/ch0rch/seodraft#readme",
  "bugs": "https://github.com/ch0rch/seodraft/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ch0rch/seodraft.git"
  },
  "author": "ch0rch (https://github.com/ch0rch)",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "seodraft": "bin/seodraft.mjs"
  },
  "pi": {
    "skills": [
      "./skill"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "bin",
    "src",
    "skill",
    "prompts",
    "!**/*.test.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "check:deps": "node scripts/check-no-runtime-deps.mjs",
    "smoke": "node scripts/smoke-tarball.mjs"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
